# OpenCode client environment (Windows user env or daytona/.env)

# Broker
DAYTONA_BROKER_URL=http://localhost:8080
OPENCODE_USER_ID=alice
DAYTONA_BROKER_MODE=exclusive

# Provider: e2b (self-hosted Docker runtime) | daytona | aio
SANDBOX_PROVIDER=e2b
E2B_RUNTIME_URL=http://localhost:8090
E2B_WORK_DIR=/home/user/project

# When SANDBOX_PROVIDER=aio
# AIO_RUNTIME_URL=http://localhost:8090
# AIO_WORK_DIR=/home/gem/workspace

# Required only when SANDBOX_PROVIDER=daytona
# DAYTONA_API_URL=http://localhost:3000/api
# DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_TARGET=us

# Server deployment only
# DAYTONA_BROKER_TOKEN=eyJ...

# Scenario 3 pool id
# DAYTONA_POOL_ID=default
