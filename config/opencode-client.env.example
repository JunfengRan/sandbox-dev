# OpenCode client environment (Windows user env or daytona/.env)

DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_TARGET=us

# Broker service
DAYTONA_BROKER_URL=http://localhost:8080
OPENCODE_USER_ID=alice

# exclusive | user_shared | multi_user_shared
DAYTONA_BROKER_MODE=exclusive

# Server deployment only
# DAYTONA_BROKER_TOKEN=eyJ...

# Scenario 3 pool id
# DAYTONA_POOL_ID=default
