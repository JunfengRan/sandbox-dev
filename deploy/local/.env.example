# Copy to deploy/local/.env and fill in values

# Provider: e2b (self-hosted Docker runtime) | daytona | aio
SANDBOX_PROVIDER=e2b

# Sandbox envelope (elastic size)
SANDBOX_SIZE_PROFILE=small
SANDBOX_CPU=0.5
SANDBOX_MEMORY_MIB=512
SANDBOX_DISK_GIB=3

# Per-exec process hard limits (optional)
PROCESS_LIMIT_CPU_SECONDS=60
PROCESS_LIMIT_MEMORY_MIB=256

# --- E2B-compatible runtime (default) ---
RUNTIME_BACKEND=e2b
E2B_RUNTIME_URL=http://sandbox-runtime:8090
E2B_IMAGE=sandbox-dev/e2b-runtime:0.1.0
E2B_WORK_DIR=/home/user/project

# --- AIO (agent-infra) ---
# When using aio: SANDBOX_PROVIDER=aio, RUNTIME_BACKEND=aio
# Recommended envelope: SANDBOX_CPU=1 SANDBOX_MEMORY_MIB=2048
# AIO_RUNTIME_URL=http://sandbox-runtime:8090
# AIO_IMAGE=sandbox-dev/aio-runtime:0.1.0
# AIO_WORK_DIR=/home/gem/workspace
# AIO_API_KEY=
# AIO_READY_TIMEOUT_MS=120000
# AIO_DOCKER_NETWORK=sandbox-dev-aio
# Optional mainland China base for build-aio-image.ps1:
# AIO_BASE_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:1.11.0

# --- Daytona (optional; required when SANDBOX_PROVIDER=daytona) ---
DAYTONA_API_URL=http://host.docker.internal:3000/api
DAYTONA_API_KEY=your-local-daytona-api-key
DAYTONA_TARGET=us
# DAYTONA_SNAPSHOT=sandbox-dev-multi-user

MAX_SANDBOX_CONCURRENCY=2
IDLE_POLICY=stop_keep
DEFAULT_BROKER_MODE=exclusive
JWT_SECRET=local-dev-secret

# --- OpenCode workspace service (requires exclusive mode) ---
# Build snapshots/Dockerfile.opencode-runtime before enabling this locally.
# E2B_IMAGE=sandbox-dev/opencode-runtime:1.18.13
# OPENCODE_SERVICE_ENABLED=true
# OPENCODE_SERVICE_PASSWORD=replace-with-a-long-random-internal-secret
# OPENCODE_SERVICE_COMMAND=opencode serve --hostname 0.0.0.0 --port 4096
# OPENCODE_SERVICE_PORT=4096
# Local model demo (keys belong in gitignored .env.demo.secrets, not committed files):
# OPENCODE_DEMO_CONFIG=true
# DEEPSEEK_API_KEY=

LEASE_TTL_MS=120000
LEASE_SWEEP_INTERVAL_MS=30000
