SANDBOX_PROVIDER=daytona
DAYTONA_API_URL=http://host.docker.internal:3000/api
DAYTONA_API_KEY=
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=sandbox-dev-opencode
# Alpine OpenCode runtime workdir (same as E2B opencode-runtime image)
PROJECT_BASE_PATH=/home/user/project
JWT_SECRET=local-dev-secret
OPENCODE_SERVICE_ENABLED=true
OPENCODE_SERVICE_PASSWORD=probe-secret
OPENCODE_SERVICE_PORT=4096
OPENCODE_SERVICE_READY_TIMEOUT_MS=120000
OPENCODE_SERVICE_COMMAND=opencode serve --hostname 0.0.0.0 --port 4096
SANDBOX_CPU=1
SANDBOX_MEMORY_MIB=2048
SANDBOX_DISK_GIB=3
