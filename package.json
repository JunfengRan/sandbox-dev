{
  "name": "sandbox-dev",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @sandbox-dev/shared && npm run build -w @sandbox-dev/broker && npm run build -w @sandbox-dev/opencode-plugin",
    "broker:dev": "npm run dev -w @sandbox-dev/broker",
    "broker:start": "npm run start -w @sandbox-dev/broker",
    "plugin:build": "npm run build -w @sandbox-dev/opencode-plugin",
    "start:local": "powershell -File scripts/start-local.ps1 -Build",
    "test:scenarios": "powershell -File scripts/run-all-tests.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
